# Copy to .env for local development. On Render, set these in the dashboard (see render.yaml).

# --- AI review (primary 4-way Red/Green/Blue/Unverified triage & rubric grading) ---------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
FALLBACK_MODEL=claude-haiku-4-5-20251001
LLM_ENABLED=true
LLM_FULL_TRIAGE=true
LLM_BATCH_SIZE=8
LLM_CONCURRENCY=3

# --- Access control ---------------------------------------------------------------------------
# REQUIRE_AUTH=true makes every /api endpoint except health/config/samples demand the token below.
REQUIRE_AUTH=false
API_AUTH_TOKEN=

# --- Sandbox (C, C++, Python, Bash, Node/JS) --------------------------------------------------
ENABLE_GCC_SANDBOX=true
GCC_TIMEOUT_SECONDS=3.0           # wall clock per test case
COMPILE_TIMEOUT_SECONDS=10
RLIMIT_AS_BYTES=268435456         # 256 MB address space per student program

# --- Plagiarism & Stylometry ------------------------------------------------------------------
CLONE_THRESHOLD_PERCENT=88
CLONE_NEAR_EXACT_PERCENT=97
CLONE_EXCLUSIVE_MIN_PERCENT=20
COLLUSION_MIN_QUESTIONS=2

# --- Limits / storage -------------------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800
MAX_UNCOMPRESSED_BYTES=104857600
MAX_STUDENTS_PER_SESSION=250
MAX_QUESTIONS_PER_PAPER=20
SQLITE_DB_PATH=./data/hitl_calibration.db
